# Supabase Postgres connection string (Project Settings -> Database -> Connection string -> URI)
# Use the "Transaction pooler" (port 6543) connection string for serverless-friendly deploys.
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@[HOST]:6543/postgres

# Comma-separated list of allowed frontend origins (or * for any, dev only)
FRONTEND_ORIGIN=http://localhost:5173

# 32-byte urlsafe-base64 Fernet key used to encrypt user-supplied LLM API keys at rest.
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
APP_ENCRYPTION_KEY=

# Optional platform-level default LLM credentials (used only if a user has not
# saved their own key in Settings). Leave empty to force BYOK for every user.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
DEFAULT_LLM_PROVIDER=anthropic
DEFAULT_LLM_MODEL=claude-sonnet-5

PORT=8000
